#!/usr/bin/env bash
# log-triage: summarize plain "LEVEL message" logs and rank the top errors.
# Nagios-style exit status; the spec is tests/log_triage.bats.
set -euo pipefail

# Byte-wise sorting and matching, so results don't depend on the locale.
export LC_ALL=C

# ISO-8601 date, optionally with a time, fraction (. or ,) and zone.
# Regexes with {n} go through sed -E: GNU and BSD sed agree on them, while
# older awks (mawk on Ubuntu, BWK awk on macOS) handle {n} unreliably.
readonly TIME_RE='[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}:[0-9]{2}([.,][0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?'
readonly UUID_RE='[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}'
readonly IP_RE='[0-9]{1,3}(\.[0-9]{1,3}){3}'

usage() {
  cat <<'EOF'
Usage: log-triage [--top N] [--max-errors N] [FILE...]

Summarizes "LEVEL message" logs from FILEs, or stdin when none are given.
An ISO-8601 timestamp before the level is skipped.

Prints a count per level (ERROR, WARN, INFO, DEBUG, OTHER), then the most
frequent ERROR messages, with timestamps, UUIDs, IPs and numbers replaced
by <time>, <uuid>, <ip> and <n> so repeats group together.

  --top N         how many top errors to show (default 5)
  --max-errors N  exit CRIT (2) when there are more than N errors
  -h, --help      show this help

Exit status: 0 OK, 2 CRIT (over --max-errors), 3 UNKNOWN (usage error or
unreadable file).
EOF
}

# Print a usage error to stderr and exit UNKNOWN.
die_usage() {
  echo "log-triage: $1" >&2
  echo "Try 'log-triage --help'." >&2
  exit 3
}

is_whole_number() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

# Drop an ISO-8601 timestamp (and the space after it) from the start of a line.
strip_leading_time() {
  sed -E "s/^[[:space:]]*${TIME_RE}[[:space:]]+//"
}

# count_levels ERRORS_FILE
#   Reads log lines and prints the level counts. Writes each ERROR's message,
#   with whitespace collapsed, to ERRORS_FILE.
count_levels() {
  awk -v errors="$1" '
    NF == 0 { next }
    {
      level = toupper($1)
      if (level == "WARNING") level = "WARN"
      if (level != "ERROR" && level != "WARN" && level != "INFO" && level != "DEBUG") {
        n["OTHER"]++
        next
      }
      n[level]++
      if (level == "ERROR") {
        $1 = ""          # rebuilding $0 joins the fields with single spaces
        sub(/^ /, "")
        print > errors
      }
    }
    END {
      printf "%-5s %d\n", "ERROR", n["ERROR"]
      printf "%-5s %d\n", "WARN", n["WARN"]
      printf "%-5s %d\n", "INFO", n["INFO"]
      printf "%-5s %d\n", "DEBUG", n["DEBUG"]
      printf "%-5s %d\n", "OTHER", n["OTHER"]
    }
  '
}

# Replace the parts of a message that vary between repeats. Order matters:
# times, UUIDs and IPs contain numbers, so they go before the number rule.
normalize() {
  sed -E \
    -e "s/${TIME_RE}/<time>/g" \
    -e "s/${UUID_RE}/<uuid>/g" \
    -e "s/${IP_RE}/<ip>/g" \
    -e 's/(^|[^A-Za-z0-9_])[0-9]+/\1<n>/g'
}

# top_errors N
#   Reads normalized messages and prints the N most frequent, ties broken
#   alphabetically. awk does the cut instead of head: under pipefail, head
#   closing the pipe early can kill sort with SIGPIPE.
top_errors() {
  awk '{ count[$0]++ } END { for (m in count) printf "%d\t%s\n", count[m], m }' |
    sort -t "$(printf '\t')" -k1,1nr -k2 |
    awk -F '\t' -v top="$1" 'NR <= top { printf "%5d  %s\n", $1, $2 }'
}

main() {
  local top=5 max_errors=""
  local -a files=()

  while (($# > 0)); do
    case $1 in
      -h | --help)
        usage
        exit 0
        ;;
      --top | --max-errors)
        (($# >= 2)) || die_usage "$1 needs a value"
        is_whole_number "$2" || die_usage "$1 must be a whole number, got '$2'"
        case $1 in
          --top) top=$((10#$2)) ;;
          --max-errors) max_errors=$((10#$2)) ;;
        esac
        shift 2
        ;;
      --)
        shift
        files+=("$@")
        break
        ;;
      -?*) die_usage "unknown option '$1'" ;;
      *)
        files+=("$1")
        shift
        ;;
    esac
  done

  ((top > 0)) || die_usage "--top must be at least 1"
  local file
  for file in ${files[@]+"${files[@]}"}; do
    [[ -f "$file" && -r "$file" ]] || die_usage "cannot read '$file'"
  done

  local tmp
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064  # expand $tmp now; it's local to main
  trap "rm -rf '$tmp'" EXIT
  : >"$tmp/errors"

  if ((${#files[@]} > 0)); then
    cat -- "${files[@]}"
  else
    cat
  fi | strip_leading_time | count_levels "$tmp/errors"

  echo
  echo "Top errors:"
  if [[ -s "$tmp/errors" ]]; then
    normalize <"$tmp/errors" | top_errors "$top"
  else
    echo "  (none)"
  fi

  local errors
  errors=$(wc -l <"$tmp/errors")
  if [[ -n "$max_errors" ]] && ((errors > max_errors)); then
    exit 2
  fi
}

main "$@"
